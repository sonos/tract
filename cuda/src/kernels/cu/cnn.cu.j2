extern "C" __global__ void conv{{ rank }}d_{{ dtype }}_generic(
    const {{ ctype }} *input,
    int32_t in_n, int32_t in_c,
{%- for i in axes %}
    int32_t in_{{ i }},
{%- endfor %}
    int32_t in_n_stride, int32_t in_c_stride,
{%- for i in axes %}
    int32_t in_{{ i }}_stride,
{%- endfor %}

    const {{ ctype }} *kernel,
    int32_t groups, int32_t co_per_group, int32_t ci_per_group,
{%- for i in axes %}
    int32_t ker_{{ i }},
{%- endfor %}
    int32_t ker_g_stride, int32_t ker_o_stride, int32_t ker_i_stride,
{%- for i in axes %}
    int32_t ker_{{ i }}_stride,
{%- endfor %}

    const {{ ctype }} *bias,
    int32_t bias_stride,

{%- for i in axes %}
    int32_t pad_{{ i }},
{%- endfor %}
{%- for i in axes %}
    int32_t stride_{{ i }},
{%- endfor %}
{%- for i in axes %}
    int32_t dil_{{ i }},
{%- endfor %}

    {{ ctype }} *output,
    int32_t out_n, int32_t out_c,
{%- for i in axes %}
    int32_t out_{{ i }},
{%- endfor %}
    int32_t out_n_stride, int32_t out_c_stride
{%- for i in axes %}
    , int32_t out_{{ i }}_stride
{%- endfor %}
) {
  assert(in_n == gridDim.z);
  assert(out_n == gridDim.z);
  assert(blockDim.z == 1);

  assert(blockDim.y == 1);

  size_t n = blockIdx.z;
  size_t co = blockIdx.y;
  size_t group = co / co_per_group;
  size_t xyz = blockIdx.x * blockDim.x + threadIdx.x;
{%- for i in axes_rev %}
  size_t ox_{{ i }} = xyz % out_{{ i }};
  xyz = xyz / out_{{ i }};
{%- endfor %}
  size_t ox_{{ rank }} = xyz;

{%- for i in axes %}
  if (ox_{{ i }} >= out_{{ i }}) {
    return;
  }
{%- endfor %}

  const {{ ctype }} *pfi = input + n * in_n_stride + ci_per_group * group * in_c_stride;
  const {{ ctype }} *pfk = kernel + co * ker_o_stride;

  float sum = 0;
  if (bias) {
    sum = {{ load }}*(bias + co * bias_stride){{ load_close }};
  }

  for (int ci = 0; ci < ci_per_group; ci++) {
{%- for i in axes %}
    for (int k_{{ i }} = 0; k_{{ i }} < ker_{{ i }}; k_{{ i }}++) {
      int x_{{ i }} = ox_{{ i }} * stride_{{ i }} + k_{{ i }} * dil_{{ i }} - pad_{{ i }};
      if (x_{{ i }} < 0 || x_{{ i }} >= in_{{ i }}) {
        continue;
      }
{%- endfor %}
      float i = {{ load }}*(pfi + ci * in_c_stride{% for a in axes %} + x_{{ a }} * in_{{ a }}_stride{% endfor %}){{ load_close }};
      float k = {{ load }}*(pfk + ci * ker_i_stride{% for a in axes %} + k_{{ a }} * ker_{{ a }}_stride{% endfor %}){{ load_close }};
      sum += i * k;
{%- for i in axes %}
    }
{%- endfor %}
  }

  size_t poffset = n * out_n_stride + co * out_c_stride{% for a in axes %} + ox_{{ a }} * out_{{ a }}_stride{% endfor %};
  *(output + poffset) = {{ store }}sum{{ store_close }};
}
