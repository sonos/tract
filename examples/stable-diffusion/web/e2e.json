        222, 214, 245, 200, 186, 45, 74, 117, 204, 198, 164, 98, 121, 127, 161, 178,
        214, 194, 141, 109, 141, 141, 123, 197, 226, 221, 186, 202, 224, 121, 210, 177,
        71, 99, 81, 122, 96, 140, 87, 115, 139, 155, 250, 244, 207, 233, 221, 87
      ]
  },
  "steps": [
    {
      "wait": "document.getElementById('status').textContent === 'Ready.'"
    },
    {
      "run": "[...document.querySelectorAll('#examples button')].find((b) => b.textContent === 'Fox').click(), document.getElementById('steps').value = 8, document.getElementById('go').click()"
    },
    {
      "wait": "document.getElementById('status').textContent.startsWith('Done')"
    },
    {
      "name": "image matches the native rendering",
      "check": "(() => { const c = document.getElementById('out'); const d = c.getContext('2d').getImageData(0, 0, c.width, c.height).data; const n = 16, bw = c.width / n, bh = c.height / n, ref = SPEC.reference; let diff = 0; for (let by = 0; by < n; by++) for (let bx = 0; bx < n; bx++) { let s = 0; for (let y = by * bh; y < (by + 1) * bh; y++) for (let x = bx * bw; x < (bx + 1) * bw; x++) { const i = (y * c.width + x) * 4; s += d[i] + d[i + 1] + d[i + 2]; } diff += Math.abs(s / (3 * bw * bh) - ref.luma[by * n + bx]); } diff /= n * n; return { fail: diff > ref.max_mean_abs_diff && 'the image differs from the reference', info: `mean abs diff ${diff.toFixed(2)} / ${ref.max_mean_abs_diff}` }; })()"
    }
  ]
}
