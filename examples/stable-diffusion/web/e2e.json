  "fail": "(document.getElementById('status').textContent.startsWith('Error') || document.getElementById('go').textContent === 'Unsupported') && document.getElementById('status').textContent",
  "reference": {
    "about": "16x16 block means of (r+g+b)/3 of the Fox example at 8 steps, rendered by sd15-native",
    "max_mean_abs_diff": 3,
    "luma": [
        152, 83, 109, 57, 50, 45, 95, 224, 243, 238, 219, 43, 52, 211, 233, 172,
        100, 67, 75, 55, 54, 50, 89, 211, 212, 173, 178, 50, 27, 102, 226, 241,
