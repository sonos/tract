version 1.0;

extension tract_registry tract_core;

# Sampling corners as a deformable convolution computes them: rounded down, cast to integers,
# moved by one and clipped into range. Rounded first, they are exact in f32.
graph network( x ) -> ( output )
{
    x = external<scalar>(shape = [2, 4, 2]);
    data = [[[[0.751, 2.383, 1.654], [-1.649, -1.199, 2.241], [-2.968, 1.927, 1.782], [-0.192, -1.182, -1.329], [-1.471, -0.330, 0.027]], [[0.321, 2.973, 1.756], [0.733, 2.934, -1.708], [-2.039, 0.675, -2.736], [-2.786, 0.089, -0.203], [2.503, 0.775, 0.085]], [[-0.019, -1.515, -2.929], [-1.846, 1.152, -1.796], [-0.783, -2.978, 1.980], [-2.073, -1.394, 2.282], [0.059, 2.083, 0.838]], [[1.451, -2.451, 0.247], [0.047, 2.228, -0.832], [0.589, -2.644, -0.674], [-1.062, -2.099, 1.898], [-0.723, 2.872, 0.540]], [[0.630, 0.828, 1.059], [-2.095, -0.358, -1.563], [-0.585, -2.420, 2.807], [-1.710, 1.031, -1.197], [2.244, 0.973, -2.210]], [[2.070, 2.670, 2.424], [0.418, -2.127, -1.845], [2.567, 0.314, -1.917], [2.304, 0.849, 0.418], [-0.742, -0.534, -1.563]]], [[[-2.772, 2.257, -0.194], [0.286, -1.067, 1.508], [-2.849, -0.767, -2.818], [-2.263, 2.803, 0.947], [-0.431, 0.142, 2.237]], [[-0.935, 0.542, 1.102], [-0.868, 0.115, 1.591], [2.455, -2.094, 2.601], [-2.969, 1.518, 1.863], [-2.179, -0.487, 1.892]], [[-2.914, 0.771, 1.758], [0.078, 1.355, -1.641], [-1.809, -0.821, -1.924], [-0.924, 2.689, 0.440], [-0.960, -1.371, 2.712]], [[-0.333, 2.882, 0.093], [0.127, 2.379, 1.457], [0.484, -0.440, 2.269], [-0.530, 2.537, -2.588], [-0.420, 0.117, 2.706]], [[-1.494, 1.836, 1.059], [1.303, 0.778, 2.829], [-1.004, -0.610, -1.783], [-2.696, -1.723, 2.493], [2.041, -2.326, 0.623]], [[-0.125, 0.568, 0.956], [-1.160, 2.768, -0.205], [0.769, 0.811, -1.897], [-2.629, -0.531, 1.584], [1.891, 1.380, -2.321]]]];
    one = tract_core_cast([[[1]]], to = "i64");
    low = tract_core_cast([[[0]]], to = "i64");
    high = tract_core_cast([[[5, 4]]], to = "i64");
    corners = min(max(add(tract_core_cast(floor(x), to = "i64"), one), low), high);
    indices = concat([corners, corners], axis = 1);
    output = tract_core_gather_nd(data, indices, batch_dims = 1);
}
