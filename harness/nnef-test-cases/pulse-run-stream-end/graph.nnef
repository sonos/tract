version 1.0;

extension tract_registry tract_core;
extension tract_symbol S;
extension tract_assert S>=0;

# Transposed convolution with a bias, kernel 4 at stride 2.  Pulsified, a
# PulseMask zeroes the deconv's input past the end of the stream, which it
# reads from the streaming symbol: a pulsed `run` over a whole input has to
# bind that symbol to the stream's length in frames, or the mask cuts the
# stream short.
graph network(input) -> (output)
{
    input  = external<scalar>(shape = [1, 2, S]);
    kernel = [[[0.5, -1.0, 0.25, 2.0], [1.5, 0.5, -0.5, 1.0]], [[-0.25, 1.0, 0.75, -1.5], [0.5, 0.5, 1.0, -0.5]], [[1.0, 0.0, -1.0, 0.5], [0.25, -0.75, 0.5, 1.25]]];
    bias   = [[0.1, -0.2, 0.3]];
    output = deconv(input, kernel, bias, padding = [(0, 0)], stride = [2], dilation = [1], groups = 1, border = 'constant');
}
