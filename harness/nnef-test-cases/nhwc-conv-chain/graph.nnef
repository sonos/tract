version 1.0;

# Three NHWC-able convs with a group norm, a silu and a residual add between them:
# on a GPU, only the transposes at the region's two ends should be left.
graph network( x ) -> ( output )
{
    x = external<scalar>(shape = [1, 4, 8, 6]);
    k0 = [[[[0.612, -0.767, 0.125],   [-0.170, -0.136, -0.065],   [-0.606, -0.070, -0.260]],  [[0.997, 0.068, -0.106],   [-0.084, -0.200, -0.317],   [-0.117, 0.145, -0.072]],  [[0.287, -0.060, 0.007],   [0.464, 0.164, -0.152],   [-0.055, 0.162, 0.581]],  [[-0.081, -0.073, 0.301],   [-0.266, -0.088, 0.265],   [0.174, 0.027, 0.201]]], [[[-0.848, 0.306, -0.288],   [-0.501, 0.083, 0.210],   [-0.133, -0.323, 0.008]],  [[-0.016, 0.422, 0.224],   [0.058, 0.333, -0.062],   [-0.278, 0.175, 0.175]],  [[-0.064, -0.235, 0.069],   [-0.748, 0.207, 0.147],   [-0.492, 0.018, -0.289]],  [[0.227, -0.610, -0.274],   [0.213, 0.347, -0.647],   [-0.149, 0.098, -0.183]]], [[[0.477, -0.357, 0.106],   [-0.315, 0.422, -0.006],   [-0.112, -0.515, 0.505]],  [[0.226, 0.226, 0.341],   [0.105, -0.192, -0.240],   [-0.240, 0.411, -0.438]],  [[-0.179, -0.096, 0.067],   [0.173, -0.375, -0.519],   [-0.001, 0.364, 0.227]],  [[0.065, -0.095, 0.088],   [-0.073, 0.245, -0.238],   [0.040, -0.033, 0.163]]], [[[0.067, 0.765, 0.450],   [0.449, -0.612, -0.102],   [-0.183, 0.160, -0.684]],  [[0.352, 0.320, -0.391],   [-0.294, -0.240, 0.013],   [0.192, 0.614, -0.059]],  [[0.230, 0.047, 0.528],   [0.223, 0.411, -0.323],   [-0.058, -0.244, 0.451]],  [[0.197, -0.092, -0.136],   [0.145, -0.210, -0.279],   [0.144, 0.739, -0.074]]]];
    b0 = [[-0.133, 0.012, -0.111, -0.059]];
    k1 = [[[[-0.167, -0.351, -0.401],   [0.157, 0.255, 0.003],   [0.100, 0.035, 0.042]],  [[-0.458, -0.137, 0.033],   [-0.235, -0.143, -0.246],   [-0.100, 0.256, -0.122]],  [[-0.046, 0.244, 0.193],   [0.509, -0.627, 0.257],   [-0.145, 0.040, 0.251]],  [[0.325, 0.312, 0.047],   [0.483, -0.085, -0.042],   [0.240, -0.165, 0.648]]], [[[0.306, 0.653, -0.008],   [-0.115, 0.050, 0.220],   [-0.176, 0.114, -0.005]],  [[0.485, -0.199, 0.314],   [-0.193, -0.288, -0.213],   [-0.357, 0.044, 0.309]],  [[0.049, 0.187, 0.490],   [0.081, 0.059, -0.083],   [-0.482, 0.228, -0.527]],  [[0.196, -0.004, 0.338],   [-0.020, -0.247, 0.107],   [-0.168, -0.054, 0.013]]], [[[-0.040, -0.057, -0.250],   [-0.057, -0.642, -0.047],   [-0.359, 0.336, 0.381]],  [[-0.585, 0.043, -0.038],   [-0.314, 0.159, -0.139],   [-0.530, -0.080, -0.044]],  [[0.032, -0.369, 0.185],   [0.221, -0.344, -0.198],   [-0.024, -0.170, 0.523]],  [[0.063, -0.303, -0.236],   [-0.017, 0.689, -0.053],   [0.038, 0.154, -0.012]]], [[[0.684, -0.159, 0.223],   [0.048, 0.186, -0.353],   [0.530, -0.036, 0.010]],  [[-0.280, -0.219, 0.169],   [0.296, 0.226, 0.363],   [0.214, 0.009, 0.251]],  [[0.178, -0.030, 0.218],   [0.386, 0.070, -0.107],   [0.216, 0.570, -0.063]],  [[-0.028, -0.041, 0.367],   [-0.551, 0.110, 0.358],   [-0.244, 0.447, 0.161]]]];
    b1 = [[0.009, 0.048, -0.107, 0.080]];
    k2 = [[[[-0.165, 0.061, -0.460],   [-0.170, 0.548, -0.268],   [0.553, -0.024, 0.298]],  [[0.013, -0.672, -0.172],   [0.057, -0.345, -0.404],   [0.110, -0.195, -0.509]],  [[-0.205, 0.258, -0.142],   [0.280, 0.458, 0.010],   [-0.339, -0.390, -0.008]],  [[0.264, 0.081, 0.164],   [-0.133, 0.090, -0.141],   [-0.098, -0.388, -0.472]]], [[[-0.145, -0.332, -0.288],   [0.201, -0.032, 0.874],   [0.278, -0.190, 0.233]],  [[0.107, -0.206, 0.331],   [-0.233, -0.918, 0.238],   [-0.185, 0.446, -0.195]],  [[-0.354, 0.465, -0.323],   [0.061, 0.435, 0.034],   [-0.024, 0.031, 0.252]],  [[-0.242, 0.183, 0.173],   [0.700, -0.101, -0.274],   [0.221, -0.119, 0.087]]], [[[0.040, 0.351, -0.197],   [-0.028, -0.766, -0.267],   [0.461, -0.204, -0.210]],  [[-0.365, 0.174, 0.053],   [-0.356, 0.200, 0.078],   [0.226, -0.192, 0.521]],  [[0.123, -0.035, -0.156],   [-0.073, 0.258, -0.081],   [0.323, 0.174, 0.404]],  [[0.244, -0.019, -0.573],   [0.090, 0.237, 0.049],   [0.167, -0.141, -0.114]]], [[[-0.283, 0.409, 0.048],   [-0.148, -0.400, -0.046],   [0.433, 0.139, -0.217]],  [[0.429, 0.429, 0.294],   [0.237, 0.347, 0.163],   [0.233, -0.234, 0.450]],  [[0.069, 0.607, -0.613],   [0.212, 0.294, -0.103],   [0.136, 0.224, 0.173]],  [[-0.162, -0.043, 0.306],   [0.383, 0.030, 0.023],   [0.060, 0.311, -0.316]]]];
    b2 = [[-0.177, 0.055, -0.158, -0.127]];
    c0 = conv(x, k0, b0, border = 'constant', padding = [(1, 1), (1, 1)]);
    grouped = reshape(c0, shape = [1, 2, -1]);
    mean = mean_reduce(grouped, axes = [2]);
    centered = sub(grouped, mean);
    variance = mean_reduce(sqr(centered), axes = [2]);
    normed = reshape(mul(centered, rsqrt(add(variance, 1e-5))), shape = [1, 4, 8, 6]);
    activated = mul(normed, sigmoid(normed));
    c1 = conv(activated, k1, b1, border = 'constant', padding = [(1, 1), (1, 1)]);
    residual = add(c1, c0);
    output = conv(residual, k2, b2, border = 'constant', padding = [(1, 1), (1, 1)]);
}
