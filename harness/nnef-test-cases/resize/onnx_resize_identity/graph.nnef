version 1.0;

extension tract_registry tract_core;
extension tract_registry tract_onnx;

graph network(input_0) -> (output_0)
{
    input_0 = tract_core_external(shape = [1, 2, 3, 4], datum_type = 'f32');
    scales = [1.0, 1.0, 1.0, 1.0];
    output_0 = tract_onnx_resize(input_0, scales = scales, interpolator = 'nearest', coord_transformer = 'half_pixel', nearest_mode = 'round_prefer_floor', antialias = true);
}
