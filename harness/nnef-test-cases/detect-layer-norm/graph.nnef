version 1.0;

# LayerNormalization as ONNX exporters emit it, with its learned gamma and beta.
graph network( x ) -> ( output )
{
    x = external<scalar>(shape = [2, 5, 64]);
    gamma = [[[0.551, 0.651, 0.936, 0.706, 0.682, 0.773, 1.378, 0.536, 1.422, 0.949, 1.238, 1.012, 1.445, 0.681, 0.755, 1.008, 1.008, 0.831, 0.805, 0.589, 1.002, 1.331, 1.367, 0.915, 1.480, 1.467, 0.820, 0.617, 1.336, 1.441, 1.149, 1.464, 0.978, 1.024, 0.574, 0.870, 1.425, 0.603, 0.637, 0.533, 0.996, 1.103, 1.033, 1.379, 1.181, 1.137, 1.103, 1.006, 0.575, 0.597, 1.144, 0.712, 0.915, 1.147, 1.100, 0.744, 0.767, 0.641, 1.163, 1.220, 0.632, 0.771, 0.649, 1.112]]];
    beta = [[[-0.204, 0.370, -0.234, 0.144, 0.136, 0.442, 0.223, 0.433, 0.084, -0.497, -0.174, 0.241, -0.157, 0.158, -0.382, 0.147, -0.115, 0.446, -0.429, -0.139, 0.267, -0.108, -0.038, -0.166, -0.402, -0.180, 0.377, 0.267, -0.190, 0.168, 0.294, 0.297, -0.445, -0.336, 0.456, -0.220, 0.279, 0.130, 0.372, -0.422, 0.434, 0.376, -0.262, 0.211, -0.494, 0.365, -0.085, 0.240, 0.295, -0.473, 0.382, -0.395, -0.345, -0.044, -0.247, 0.148, -0.309, 0.123, 0.262, 0.464, -0.101, -0.214, 0.078, 0.151]]];
    mean = mean_reduce(x, axes = [2]);
    centered = sub(x, mean);
    variance = mean_reduce(sqr(centered), axes = [2]);
    normed = mul(centered, rsqrt(add(variance, 1e-5)));
    output = add(mul(normed, gamma), beta);
}
