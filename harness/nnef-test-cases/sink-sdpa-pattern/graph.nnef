version 1.0;
extension tract_registry tract_core;
extension tract_registry tract_transformers;
extension tract_symbol S;
extension tract_symbol T;
graph attention(q, k, v, mask, sinks) -> (output) {
    q = external<scalar>(shape = [1, 4, S, 64]);
    k = external<scalar>(shape = [1, 2, T, 64]);
    v = external<scalar>(shape = [1, 2, T, 64]);
    mask = external<scalar>(shape = [1, 1, S, T]);
    sinks = external<scalar>(shape = [4]);
    q16 = tract_core_cast(q, to = 'f16');
    k16 = tract_core_cast(k, to = 'f16');
    v16 = tract_core_cast(v, to = 'f16');
    mask3 = reshape(mask, shape = [1, S, T]);
    qa = slice(q16, axes = [3], begin = [0], end = [32]);
    qb = slice(q16, axes = [3], begin = [32], end = [64]);
    qag = reshape(qa, shape = [2, 2], axis_start = 1, axis_count = 1);
    qbg = reshape(qb, shape = [2, 2], axis_start = 1, axis_count = 1);
    kg = unsqueeze(k16, axes = [2]);
    kb = tract_core_broadcast(kg, shape = [1, 2, 2, T, 64]);
    ka = slice(kb, axes = [4], begin = [0], end = [32]);
    kc = slice(kb, axes = [4], begin = [32], end = [64]);
    sa = tract_core_einsum([qag, ka], expr = 'bhgsd,bhgtd->hgst', acc = 'f16');
    sb = tract_core_einsum([qbg, kc], expr = 'bhgsd,bhgtd->hgst', acc = 'f16');
    saf = reshape(sa, shape = [4], axis_start = 0, axis_count = 2);
    sbf = reshape(sb, shape = [4], axis_start = 0, axis_count = 2);
    scores = add(saf, sbf);
    scaled = mul(scores, 0.125);
    scaled32 = tract_core_cast(scaled, to = 'f32');
    masked = add(scaled32, mask3);
    sh = reshape(sinks, shape = [4, 1, 1]);
    sinks_b = tract_core_broadcast(sh, shape = [4, S, 1]);
    logits = concat([masked, sinks_b], axis = 2);
    maximum = max_reduce(logits, axes = [2]);
    stable = sub(logits, maximum);
    probabilities = softmax(stable, axes = [2]);
    weights = slice(probabilities, axes = [2], begin = [0], end = [T]);
    weights16 = tract_core_cast(weights, to = 'f16');
    grouped = reshape(weights16, shape = [2, 2], axis_start = 0, axis_count = 1);
    result = tract_core_einsum([grouped, v16], expr = 'hgsk,bhkd->hgsd', acc = 'f16');
    output = reshape(result, shape = [1, 4, S, 64]);
}
